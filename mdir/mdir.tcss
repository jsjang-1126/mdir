Screen {
    layout: vertical;
}

#main-layout {
    height: 1fr;
    min-height: 1;
    layout: horizontal;
}

#panels {
    width: 2fr;
    height: 1fr;
    min-height: 1;
    layout: horizontal;
}

#preview-pane {
    width: 1fr;
    min-width: 24;
    height: 1fr;
    min-height: 1;
}

#status-bar {
    height: 1;
    background: $surface-darken-1;
    color: $text-muted;
    padding: 0 1;
}

#help-bar {
    height: 1;
    background: $primary-background;
    color: $text;
    padding: 0 1;
}
